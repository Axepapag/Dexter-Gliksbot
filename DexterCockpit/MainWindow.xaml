<Window x:Class="DexterCockpit.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:DexterCockpit"
        xmlns:dock="clr-namespace:DexterCockpit.Docking"
        xmlns:views="clr-namespace:DexterCockpit.Views"
        Title="Dexter Cockpit"
        Height="620"
        Width="960"
        MinWidth="840"
        MinHeight="520"
        ResizeMode="CanResize"
        Topmost="True"
        Background="#FF121212">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Border Grid.Row="0" Background="#FF1F1F21" Padding="12,10">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="Window:" Foreground="#FFEEEEEE" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <ComboBox Name="WindowCombo" Width="280" Margin="0,0,8,0" DisplayMemberPath="Display" IsEditable="True"/>
                <Button Name="BtnRefreshWindows" Content="Refresh" Width="90" Height="32" Margin="0,0,8,0"/>
                <Button Name="BtnDockSelected" Content="Dock" Width="90" Height="32" Margin="0,0,8,0"/>
                <Button Name="BtnWindowBrowser" Content="Browse..." Width="90" Height="32" Margin="0,0,12,0"/>
                <Button Name="BtnDetach" Content="Detach" Width="90" Height="32" Margin="0,0,12,0"/>
                <Separator Width="1" Margin="0,0,12,0" />
                <Button Name="BtnEndpoints" Content="Endpoints..." Height="32" Margin="0,0,8,0"/>
                <Button Name="BtnPanic" Content="Panic (Ctrl+Alt+P)" Height="32" Background="#FF4A1F1F" Foreground="White" Margin="0,0,8,0"/>
                <Button Name="BtnChatConsole" Content="Chat Console" Height="32"/>
            </StackPanel>
        </Border>

        <Grid Grid.Row="1" Margin="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.6*" MinWidth="360"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*" MinWidth="320"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="#FF161618" BorderBrush="#FF2B2B2E" BorderThickness="1" CornerRadius="6" Margin="0,0,10,0">
                <Grid>
                    <dock:DockHostControl x:Name="DockHost" Margin="0"/>
                    <Border x:Name="DockGlow" IsHitTestVisible="False" Background="#443BCDFF" Visibility="Collapsed" CornerRadius="6" Margin="4"/>
                    <Border x:Name="DockInfoBadge" IsHitTestVisible="False"
                            Visibility="Collapsed"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Top"
                            Margin="14"
                            Padding="10,8"
                            CornerRadius="6"
                            Background="#AA1E88E5">
                        <StackPanel>
                            <TextBlock Text="Docked window" Foreground="White" FontWeight="Bold"/>
                            <TextBlock x:Name="DockInfoTitle" Foreground="#FFF4F4F4" TextWrapping="Wrap" MaxWidth="280"/>
                        </StackPanel>
                    </Border>
                    <StackPanel x:Name="DockPlaceholder" VerticalAlignment="Center" HorizontalAlignment="Center" Width="340">
                        <TextBlock Text="No window docked yet." Foreground="#FFAAAAAA" FontSize="16" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                        <TextBlock Text="Use the dropdown or Browse button to dock any desktop app inside Dexter. Drag the splitter to resize."
                                   TextWrapping="Wrap" Foreground="#FF85858A" TextAlignment="Center"/>
                        <TextBlock Text="Tip: Run the OCR action from an agent tab to see what Dexter reads."
                                   TextWrapping="Wrap" Foreground="#FF6F6F74" TextAlignment="Center" Margin="0,10,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>

            <GridSplitter Grid.Column="1"
                          Width="8"
                          Margin="4,0"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Stretch"
                          ShowsPreview="True"
                          Background="#33101010"/>

            <Border Grid.Column="2" Background="#FF161618" BorderBrush="#FF2B2B2E" BorderThickness="1" CornerRadius="6" Padding="0">
                <TabControl Margin="0" x:Name="RightTabControl">
                    <TabItem Header="Mission Control">
                        <views:MissionControlView x:Name="MissionControlView"/>
                    </TabItem>
                    <TabItem Header="Agents">
                        <Grid Margin="0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Border Grid.Row="0" Background="#FF1F1F21" Padding="12,10">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="Agents" Foreground="#FFEEEEEE" FontSize="16" FontWeight="Bold" Margin="0,0,8,0"/>
                                    <Button Name="BtnAddAgentTab" Content="Add Tab" Height="28" Padding="12,0"/>
                                </StackPanel>
                            </Border>
                            <ContentControl Grid.Row="1" Name="AgentPanelHost" Margin="12"/>
                        </Grid>
                    </TabItem>
                    <TabItem Header="Policy">
                        <local:PolicyEditorControl x:Name="PolicyEditor" Margin="12"/>
                    </TabItem>
                </TabControl>
            </Border>
        </Grid>

        <Border Grid.Row="2" Background="#FF1F1F21" Padding="10">
            <StackPanel Orientation="Horizontal">
                <TextBlock Name="DockStatus" Foreground="#FFB0B0B5" Margin="0,0,12,0"/>
                <TextBlock Name="EndpointStatus" Foreground="#FF7F7F83" Margin="0,0,12,0"/>
                <TextBlock Name="PolicyStatus" Foreground="#FF77777B" />
            </StackPanel>
        </Border>
    </Grid>
</Window>


