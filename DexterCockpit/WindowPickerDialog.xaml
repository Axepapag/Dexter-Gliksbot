<Window x:Class="DexterCockpit.WindowPickerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Select Window to Dock"
        Height="480"
        Width="560"
        MinHeight="380"
        MinWidth="420"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal">
            <TextBox x:Name="SearchBox"
                     Width="260"
                     Height="30"
                     Margin="0,0,8,0"
                     VerticalContentAlignment="Center"
                     ToolTip="Filter by window title or process name"
                     TextChanged="SearchBox_TextChanged"/>
            <Button x:Name="BtnRefresh"
                    Width="90"
                    Height="30"
                    Content="Refresh"
                    Click="BtnRefresh_Click"/>
        </StackPanel>

        <Border Grid.Row="1"
                Margin="0,10,0,10"
                BorderBrush="#FF303033"
                BorderThickness="1"
                CornerRadius="4">
            <ListView x:Name="WindowList"
                      Margin="4"
                      MouseDoubleClick="WindowList_MouseDoubleClick"
                      SelectionMode="Single">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="Title" Width="280" DisplayMemberBinding="{Binding DisplayTitle}"/>
                        <GridViewColumn Header="Process" Width="160" DisplayMemberBinding="{Binding ProcessName}"/>
                        <GridViewColumn Header="Source" Width="80" DisplayMemberBinding="{Binding SourceLabel}"/>
                    </GridView>
                </ListView.View>
            </ListView>
        </Border>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Width="90"
                    Height="32"
                    Margin="0,0,8,0"
                    Content="Select"
                    IsDefault="True"
                    Click="BtnSelect_Click"/>
            <Button Width="90"
                    Height="32"
                    Content="Cancel"
                    IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
