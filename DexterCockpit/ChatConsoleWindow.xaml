<Window x:Class="DexterCockpit.ChatConsoleWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Dexter Chat Console"
        Height="520"
        Width="480"
        MinHeight="400"
        MinWidth="420"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Grid.Row="0" Margin="0,0,0,10">
            <TextBlock Text="Send To:"
                       VerticalAlignment="Center"
                       Margin="0,0,8,0"/>
            <ComboBox x:Name="TargetCombo"
                      Width="220"
                      DisplayMemberPath="Label"
                      SelectionChanged="TargetCombo_SelectionChanged"/>
            <Button x:Name="BtnRefreshTargets"
                    Width="100"
                    Height="30"
                    Margin="8,0,0,0"
                    Content="Refresh"
                    Click="BtnRefreshTargets_Click"/>
        </StackPanel>

        <Border Grid.Row="1"
                BorderBrush="#FF303033"
                BorderThickness="1"
                CornerRadius="4">
            <ListBox x:Name="ChatList"
                     Margin="6"
                     BorderThickness="0"
                     Background="Transparent"
                     Foreground="#FFDDDDDD">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Display}"
                                   TextWrapping="Wrap"
                                   Margin="2"/>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>

        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    Margin="0,10,0,0">
            <TextBox x:Name="MessageInput"
                     Height="34"
                     MinWidth="280"
                     VerticalContentAlignment="Center"
                     KeyDown="MessageInput_KeyDown"
                     Margin="0,0,8,0"/>
            <Button x:Name="BtnSend"
                    Width="90"
                    Height="34"
                    Content="Send"
                    Click="BtnSend_Click"/>
        </StackPanel>
    </Grid>
</Window>
