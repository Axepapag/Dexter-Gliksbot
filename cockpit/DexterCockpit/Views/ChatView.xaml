<UserControl x:Class="DexterCockpit.Views.ChatView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="800"
             Background="#1E1E1E">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Toolbar -->
            <RowDefinition Height="*"/>    <!-- Chat messages -->
            <RowDefinition Height="Auto"/> <!-- Input area -->
        </Grid.RowDefinitions>

        <!-- Toolbar -->
        <Border Grid.Row="0" Background="#2D2D30" Padding="10" BorderBrush="#007ACC" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Mode Toggle -->
                <ToggleButton Grid.Column="0"
                              IsChecked="{Binding IsBroadcastMode}"
                              Style="{StaticResource MaterialDesignSwitchToggleButton}"
                              ToolTip="Toggle Broadcast Mode"
                              Margin="0,0,15,0">
                    <ToggleButton.Content>
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="BroadcastOn" Width="20" Height="20" Margin="0,0,8,0"/>
                            <TextBlock Text="Broadcast Mode" FontSize="12"/>
                        </StackPanel>
                    </ToggleButton.Content>
                </ToggleButton>

                <!-- Agent Selector (when not in broadcast) -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="15,0,0,0"
                            Visibility="{Binding IsBroadcastMode, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                    <TextBlock Text="Agent:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <ComboBox ItemsSource="{Binding AvailableAgents}"
                              SelectedValue="{Binding SelectedAgentId}"
                              DisplayMemberPath="Name"
                              SelectedValuePath="Id"
                              MinWidth="150"
                              Style="{StaticResource MaterialDesignComboBox}"/>
                </StackPanel>

                <!-- TTS and Mic Controls -->
                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <!-- TTS Mute -->
                    <ToggleButton IsChecked="{Binding IsTtsMuted}"
                                  Style="{StaticResource MaterialDesignActionToggleButton}"
                                  ToolTip="Mute/Unmute TTS"
                                  Width="36" Height="36"
                                  Margin="4">
                        <ToggleButton.Content>
                            <materialDesign:PackIcon Kind="VolumeHigh" Width="24" Height="24"/>
                        </ToggleButton.Content>
                        <materialDesign:ToggleButtonAssist.OnContent>
                            <materialDesign:PackIcon Kind="VolumeMute" Width="24" Height="24" Foreground="Red"/>
                        </materialDesign:ToggleButtonAssist.OnContent>
                    </ToggleButton>

                    <!-- Microphone -->
                    <ToggleButton IsChecked="{Binding IsMicrophoneActive}"
                                  Style="{StaticResource MaterialDesignActionToggleButton}"
                                  ToolTip="Push to Talk (Microphone)"
                                  Width="36" Height="36"
                                  Margin="4">
                        <ToggleButton.Content>
                            <materialDesign:PackIcon Kind="Microphone" Width="24" Height="24"/>
                        </ToggleButton.Content>
                        <materialDesign:ToggleButtonAssist.OnContent>
                            <materialDesign:PackIcon Kind="Microphone" Width="24" Height="24" Foreground="Red"/>
                        </materialDesign:ToggleButtonAssist.OnContent>
                    </ToggleButton>

                    <!-- Clear Chat -->
                    <Button Command="{Binding ClearChatCommand}"
                            Style="{StaticResource MaterialDesignIconButton}"
                            ToolTip="Clear Chat"
                            Width="36" Height="36"
                            Margin="4">
                        <materialDesign:PackIcon Kind="DeleteSweep" Width="24" Height="24"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Chat Messages -->
        <ScrollViewer Grid.Row="1" 
                      VerticalScrollBarVisibility="Auto"
                      Padding="10"
                      Background="#1E1E1E">
            <ItemsControl ItemsSource="{Binding Messages}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Margin="0,5,0,5" 
                                Padding="10"
                                CornerRadius="8"
                                MaxWidth="600"
                                HorizontalAlignment="{Binding IsUser, Converter={StaticResource BoolToAlignmentConverter}}">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="#2D2D30"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsUser}" Value="True">
                                            <Setter Property="Background" Value="#007ACC"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>

                            <StackPanel>
                                <!-- Sender and Timestamp -->
                                <Grid Margin="0,0,0,5">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0"
                                               Text="{Binding SenderName}" 
                                               FontWeight="Bold" 
                                               FontSize="12"
                                               Foreground="{Binding IsUser, Converter={StaticResource BoolToSenderColorConverter}}"/>

                                    <TextBlock Grid.Column="1"
                                               Text="{Binding FormattedTimestamp}" 
                                               FontSize="10" 
                                               Foreground="Gray"/>
                                </Grid>

                                <!-- Message -->
                                <TextBlock Text="{Binding Message}" 
                                           TextWrapping="Wrap" 
                                           FontSize="13"
                                           Foreground="White"/>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- Input Area -->
        <Border Grid.Row="2" Background="#2D2D30" Padding="10" BorderBrush="#007ACC" BorderThickness="0,1,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Text Input -->
                <TextBox Grid.Column="0"
                         Text="{Binding InputText, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource MaterialDesignOutlinedTextBox}"
                         materialDesign:HintAssist.Hint="Type your message..."
                         FontSize="13"
                         MinHeight="40"
                         MaxHeight="120"
                         TextWrapping="Wrap"
                         AcceptsReturn="True"
                         VerticalScrollBarVisibility="Auto"
                         IsEnabled="{Binding IsWaitingForResponse, Converter={StaticResource InverseBooleanConverter}}">
                    <TextBox.InputBindings>
                        <KeyBinding Key="Enter" Command="{Binding SendMessageCommand}"/>
                    </TextBox.InputBindings>
                </TextBox>

                <!-- Send Button -->
                <Button Grid.Column="1"
                        Command="{Binding SendMessageCommand}"
                        Style="{StaticResource MaterialDesignRaisedButton}"
                        Background="#007ACC"
                        Width="80"
                        Height="40"
                        Margin="10,0,0,0"
                        IsEnabled="{Binding IsWaitingForResponse, Converter={StaticResource InverseBooleanConverter}}">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="Send" Width="20" Height="20"/>
                        <TextBlock Text="Send" Margin="8,0,0,0" FontSize="13"/>
                    </StackPanel>
                </Button>
            </Grid>
        </Border>
    </Grid>
</UserControl>
