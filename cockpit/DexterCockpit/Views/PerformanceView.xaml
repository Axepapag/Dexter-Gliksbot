<UserControl x:Class="DexterCockpit.Views.PerformanceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:lvc="clr-namespace:LiveCharts.Wpf;assembly=LiveCharts.Wpf"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="800"
             Background="#1E1E1E">

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Metrics Cards -->
        <UniformGrid Grid.Row="0" Rows="2" Columns="3" Margin="0,0,0,20">
            <!-- CPU Usage -->
            <Border Background="#2D2D30" Margin="5" Padding="15" CornerRadius="4">
                <StackPanel>
                    <TextBlock Text="CPU Usage" FontSize="12" Foreground="Gray"/>
                    <TextBlock Text="{Binding CpuUsage, StringFormat={}{0:F1}%}" 
                               FontSize="24" 
                               FontWeight="Bold" 
                               Foreground="Cyan"/>
                </StackPanel>
            </Border>

            <!-- Memory Usage -->
            <Border Background="#2D2D30" Margin="5" Padding="15" CornerRadius="4">
                <StackPanel>
                    <TextBlock Text="Memory Usage" FontSize="12" Foreground="Gray"/>
                    <TextBlock Text="{Binding MemoryUsageMb, StringFormat={}{0:F0} MB}" 
                               FontSize="24" 
                               FontWeight="Bold" 
                               Foreground="LimeGreen"/>
                </StackPanel>
            </Border>

            <!-- Redis Queue -->
            <Border Background="#2D2D30" Margin="5" Padding="15" CornerRadius="4">
                <StackPanel>
                    <TextBlock Text="Redis Queue Depth" FontSize="12" Foreground="Gray"/>
                    <TextBlock Text="{Binding RedisQueueDepth}" 
                               FontSize="24" 
                               FontWeight="Bold" 
                               Foreground="Orange"/>
                </StackPanel>
            </Border>

            <!-- Brain Size -->
            <Border Background="#2D2D30" Margin="5" Padding="15" CornerRadius="4">
                <StackPanel>
                    <TextBlock Text="Brain Size" FontSize="12" Foreground="Gray"/>
                    <TextBlock Text="{Binding BrainSizeMb, StringFormat={}{0:F1} MB}" 
                               FontSize="24" 
                               FontWeight="Bold" 
                               Foreground="Magenta"/>
                </StackPanel>
            </Border>

            <!-- Messages/Sec -->
            <Border Background="#2D2D30" Margin="5" Padding="15" CornerRadius="4">
                <StackPanel>
                    <TextBlock Text="Messages/Sec" FontSize="12" Foreground="Gray"/>
                    <TextBlock Text="{Binding MessagesPerSecond}" 
                               FontSize="24" 
                               FontWeight="Bold" 
                               Foreground="Yellow"/>
                </StackPanel>
            </Border>

            <!-- Avg Latency -->
            <Border Background="#2D2D30" Margin="5" Padding="15" CornerRadius="4">
                <StackPanel>
                    <TextBlock Text="Avg Latency" FontSize="12" Foreground="Gray"/>
                    <TextBlock Text="{Binding AvgLatencyMs, StringFormat={}{0:F2} ms}" 
                               FontSize="24" 
                               FontWeight="Bold" 
                               Foreground="White"/>
                </StackPanel>
            </Border>
        </UniformGrid>

        <!-- Charts -->
        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- CPU Chart -->
            <Border Grid.Row="0" Background="#2D2D30" Margin="5" Padding="10" CornerRadius="4">
                <StackPanel>
                    <TextBlock Text="CPU Usage (Last 60 Seconds)" 
                               FontSize="14" 
                               FontWeight="SemiBold" 
                               Foreground="White"
                               Margin="0,0,0,10"/>
                    <lvc:CartesianChart Series="{Binding CpuSeries}" 
                                        Height="200"
                                        Background="Transparent"
                                        Foreground="White">
                        <lvc:CartesianChart.AxisX>
                            <lvc:Axis Title="Time" Foreground="Gray" FontSize="10"/>
                        </lvc:CartesianChart.AxisX>
                        <lvc:CartesianChart.AxisY>
                            <lvc:Axis Title="CPU %" Foreground="Gray" FontSize="10" MinValue="0" MaxValue="100"/>
                        </lvc:CartesianChart.AxisY>
                    </lvc:CartesianChart>
                </StackPanel>
            </Border>

            <!-- Memory Chart -->
            <Border Grid.Row="1" Background="#2D2D30" Margin="5" Padding="10" CornerRadius="4">
                <StackPanel>
                    <TextBlock Text="Memory Usage (Last 60 Seconds)" 
                               FontSize="14" 
                               FontWeight="SemiBold" 
                               Foreground="White"
                               Margin="0,0,0,10"/>
                    <lvc:CartesianChart Series="{Binding MemorySeries}" 
                                        Height="200"
                                        Background="Transparent"
                                        Foreground="White">
                        <lvc:CartesianChart.AxisX>
                            <lvc:Axis Title="Time" Foreground="Gray" FontSize="10"/>
                        </lvc:CartesianChart.AxisX>
                        <lvc:CartesianChart.AxisY>
                            <lvc:Axis Title="Memory (MB)" Foreground="Gray" FontSize="10"/>
                        </lvc:CartesianChart.AxisY>
                    </lvc:CartesianChart>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
