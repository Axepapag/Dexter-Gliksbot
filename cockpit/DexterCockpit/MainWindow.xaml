<Window x:Class="DexterCockpit.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:xcad="https://github.com/Dirkster99/AvalonDock"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:views="clr-namespace:DexterCockpit.Views"
        mc:Ignorable="d"
        Title="{Binding WindowTitle}" 
        Height="900" Width="1600"
        Background="#1E1E1E"
        TextElement.Foreground="White"
        TextElement.FontFamily="Segoe UI"
        WindowState="Maximized">

    <Window.Resources>
        <!-- Dark theme for AvalonDock -->
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <materialDesign:BundledTheme BaseTheme="Dark" PrimaryColor="Blue" SecondaryColor="Cyan" />
                <ResourceDictionary Source="pack://application:,,,/MaterialDesignThemes.Wpf;component/Themes/MaterialDesignTheme.Defaults.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Top bar -->
            <RowDefinition Height="*"/>    <!-- Main content -->
            <RowDefinition Height="Auto"/> <!-- Status bar -->
        </Grid.RowDefinitions>

        <!-- Top Bar -->
        <Border Grid.Row="0" Background="#2D2D30" BorderBrush="#007ACC" BorderThickness="0,0,0,2" Padding="10,5">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Logo and Title -->
                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="Robot" Width="32" Height="32" VerticalAlignment="Center" Foreground="#007ACC"/>
                    <TextBlock Text="DEXTER MISSION CONTROL" FontSize="18" FontWeight="Bold" 
                               VerticalAlignment="Center" Margin="10,0,0,0" Foreground="#007ACC"/>
                </StackPanel>

                <!-- Connection Status -->
                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Ellipse Width="12" Height="12" VerticalAlignment="Center" Margin="0,0,8,0">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Fill" Value="Red"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                        <Setter Property="Fill" Value="LimeGreen"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>
                    <TextBlock Text="{Binding ConnectionStatus}" VerticalAlignment="Center" 
                               FontWeight="SemiBold" Foreground="White"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Content: AvalonDock Layout -->
        <xcad:DockingManager Grid.Row="1" 
                             AllowMixedOrientation="True"
                             BorderBrush="#007ACC" 
                             BorderThickness="0"
                             Background="#1E1E1E">
            
            <xcad:DockingManager.Theme>
                <xcad:Vs2013DarkTheme/>
            </xcad:DockingManager.Theme>

            <xcad:LayoutRoot>
                <!-- Single root panel with vertical orientation to stack main content and bottom logs -->
                <xcad:LayoutPanel Orientation="Vertical">
                    
                    <!-- TOP: Main content area (horizontal layout) -->
                    <xcad:LayoutPanel Orientation="Horizontal">
                        
                        <!-- LEFT: Agent Roster -->
                        <xcad:LayoutAnchorablePane DockWidth="300">
                            <xcad:LayoutAnchorable Title="Agent Roster" 
                                                   CanClose="False" 
                                                   CanHide="True"
                                                   CanFloat="True"
                                                   IconSource="/Resources/agent-icon.png">
                                <views:AgentRosterView DataContext="{Binding AgentRoster}"/>
                            </xcad:LayoutAnchorable>
                        </xcad:LayoutAnchorablePane>

                        <!-- CENTER: Main Content -->
                        <xcad:LayoutDocumentPane>
                            <!-- Main Chat Window -->
                            <xcad:LayoutDocument Title="Dexter Chat" 
                                                 CanClose="False"
                                                 IconSource="/Resources/chat-icon.png">
                                <views:ChatView DataContext="{Binding Chat}"/>
                            </xcad:LayoutDocument>

                            <!-- Performance Monitor -->
                            <xcad:LayoutDocument Title="Performance Monitor"
                                                 IconSource="/Resources/chart-icon.png">
                                <views:PerformanceView DataContext="{Binding Performance}"/>
                            </xcad:LayoutDocument>

                            <!-- Agent Tabs (dynamically added) -->
                            <!-- Per-agent tabs will be added here programmatically -->
                        </xcad:LayoutDocumentPane>

                        <!-- RIGHT: Docked Windows (future: Unity, QuickBooks, etc.) -->
                        <xcad:LayoutAnchorablePane DockWidth="350">
                            <xcad:LayoutAnchorable Title="Docked Windows" 
                                                   CanClose="False"
                                                   CanHide="True"
                                                   CanFloat="True"
                                                   IconSource="/Resources/window-icon.png">
                                <TextBlock Text="External app docking (Phase 2)" 
                                           VerticalAlignment="Center" 
                                           HorizontalAlignment="Center"
                                           Foreground="Gray"/>
                            </xcad:LayoutAnchorable>
                        </xcad:LayoutAnchorablePane>

                    </xcad:LayoutPanel>

                    <!-- BOTTOM: Logs Panel -->
                    <xcad:LayoutAnchorablePaneGroup Orientation="Horizontal" DockHeight="250">
                        <xcad:LayoutAnchorablePane>
                            <xcad:LayoutAnchorable Title="Real-Time Logs" 
                                                   CanClose="False"
                                                   CanHide="True"
                                                   CanFloat="True"
                                                   IconSource="/Resources/log-icon.png">
                                <views:LogsView DataContext="{Binding Logs}"/>
                            </xcad:LayoutAnchorable>
                        </xcad:LayoutAnchorablePane>
                    </xcad:LayoutAnchorablePaneGroup>

                </xcad:LayoutPanel>
            </xcad:LayoutRoot>
        </xcad:DockingManager>

        <!-- Status Bar -->
        <Border Grid.Row="2" Background="#2D2D30" BorderBrush="#007ACC" BorderThickness="0,2,0,0" Padding="10,3">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="Ready" Foreground="LightGray" FontSize="11"/>
                <TextBlock Grid.Column="2" Text="© 2025 Dexter Autonomy Platform" 
                           Foreground="Gray" FontSize="11"/>
            </Grid>
        </Border>
    </Grid>
</Window>
