# Dexter-Gliksbot Environment Configuration
# Copy this file to .env and fill in your values

# =============================================================================
# LLM Provider API Keys
# =============================================================================
# Note: Store sensitive keys in environment variables, not in .env files
# These are used by the provider system for authentication

# Ollama (local/cloud)
OLLAMA_API_KEY=

# OpenAI
OPENAI_API_KEY=

# NVIDIA NIMs
NVIDIA_API_KEY=

# Perplexity
PERPLEXITY_API_KEY=

# Anthropic Claude
ANTHROPIC_API_KEY=

# Groq
GROQ_API_KEY=

# GitHub Models
GITHUB_TOKEN=

# Azure OpenAI
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=

# =============================================================================
# Redis Configuration (for Celery workers)
# =============================================================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# =============================================================================
# Database Configuration
# =============================================================================
DATABASE_PATH=data/brain.db
DATABASE_BACKUP_PATH=data/backups

# =============================================================================
# API Server Configuration
# =============================================================================
API_HOST=0.0.0.0
API_PORT=8765
API_RELOAD=false

# =============================================================================
# Logging Configuration
# =============================================================================
LOG_LEVEL=INFO
LOG_FILE=data/dexter.log
LOG_FORMAT=json
LOG_ROTATION=daily
LOG_MAX_SIZE=100MB
LOG_RETENTION_DAYS=30

# =============================================================================
# WebSocket Configuration
# =============================================================================
WS_PING_INTERVAL=30
WS_PING_TIMEOUT=10
WS_MAX_MESSAGE_SIZE=10485760

# =============================================================================
# Memory Configuration
# =============================================================================
STM_MAX_SIZE_GB=10
LTM_CLEANUP_INTERVAL=3600
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# =============================================================================
# UI Automation (Windows only)
# =============================================================================
# Tesseract OCR path (auto-detected on Linux/Mac)
# Windows example: C:\\Program Files\\Tesseract-OCR\\tesseract.exe
TESSERACT_CMD=

# PyAutoGUI safety settings
PYAUTOGUI_PAUSE=0.1
PYAUTOGUI_FAILSAFE=true

# =============================================================================
# Security Configuration
# =============================================================================
# Deny list enforcement level: low, medium, high, paranoid
POLICY_PROFILE=medium

# Enable/disable policy checks
POLICY_ENABLED=true

# =============================================================================
# Agent Configuration
# =============================================================================
# Default provider for agents (ollama, openai, nvidia, perplexity, anthropic, etc.)
DEFAULT_PROVIDER=ollama

# Default model per provider
OLLAMA_DEFAULT_MODEL=qwen2.5:3b-instruct
OPENAI_DEFAULT_MODEL=gpt-4o-mini
NVIDIA_DEFAULT_MODEL=nvidia/llama-3.1-nemotron-70b-instruct
PERPLEXITY_DEFAULT_MODEL=llama-3.1-sonar-small-128k-online
ANTHROPIC_DEFAULT_MODEL=claude-3-5-sonnet-20241022
GROQ_DEFAULT_MODEL=llama-3.3-70b-versatile

# Agent execution timeout (seconds)
AGENT_TIMEOUT=300

# =============================================================================
# Celery Configuration
# =============================================================================
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0
CELERY_TASK_TRACK_STARTED=true
CELERY_TASK_TIME_LIMIT=3600

# =============================================================================
# Development Settings
# =============================================================================
DEBUG=false
DEV_MODE=false
RELOAD_ON_CHANGE=false

# =============================================================================
# Email Notifications (optional)
# =============================================================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TO=

# =============================================================================
# Monitoring & Alerting (optional)
# =============================================================================
SENTRY_DSN=
PROMETHEUS_PORT=9090

# =============================================================================
# WPF Cockpit UI Configuration
# =============================================================================
COCKPIT_WS_URL=ws://localhost:8765/ws
COCKPIT_API_URL=http://localhost:8765
COCKPIT_OCR_FPS=5
COCKPIT_LOG_BUFFER_SIZE=10000
